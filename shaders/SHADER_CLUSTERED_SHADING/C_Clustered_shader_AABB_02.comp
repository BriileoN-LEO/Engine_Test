#version 460 core
#define tileSize 16.0

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

uniform vec2 screenSize_D;
uniform mat4 inverseProj_D;

struct TilesB
{
 float minDepth;
 float maxDepth;
};

layout (std430, binding = 3) buffer tilesBoundBuffer
{
 TilesB tiles[];
};

struct cluster_D
{
 vec4 minPoint;
 vec4 maxPoint;
};

layout (std430, binding = 4) buffer clustersBuffer
{
 cluster_D clusters[];
};

vec3 screenToView(vec2 screenCoord, vec2 screenSize, float depthZ, mat4 inverseProj)
{
    vec2 NDC_xy = ((screenCoord / screenSize) * 2.0) - 1.0;
    float NDC_z = (depthZ * 2.0) - 1;

    vec4 clipSpace = vec4(NDC_xy, NDC_z, 1.0);

    vec4 viewSpace = inverseProj * clipSpace;

    return viewSpace.xyz / viewSpace.w;
}


