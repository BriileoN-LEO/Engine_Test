void main()
{
 // uint localThread_ID = gl_LocalInvocationIndex;
 // uint tileIndex = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;

  uint tileX = gl_GlobalInvocationID.x;
  uint tileY = gl_GlobalInvocationID.y;
  uint sliceZ = gl_GlobalInvocationID.z;

  uint clusterIndex = tileX + (tileY * gridDimX) + (sliceZ * gridDimX * gridDimY);

  vec2 tileSize = screenSize_D / vec2(gridDimX, gridDimY);

  vec2 pixel_ButtomLeft = vec2(tileX, tileY) * tileSize;
  vec2 pixel_TopRight = vec2(tileX + 1.0, tileY + 1.0) * tileSize;

 // float depthMin_z = tiles[tileIndex].minDepth;
 // float depthMax_z = tiles[tileIndex].maxDepth;

    //COORDINATES OF TILE IN SCREEN
  vec3 ray_TopLeft = frustrumRay(vec2(pixel_ButtomLeft.x, pixel_TopRight.y));
  vec3 ray_TopRight = frustrumRay(vec2(pixel_TopRight.x, pixel_TopRight.y));
  vec3 ray_ButtomLeft = frustrumRay(vec2(pixel_ButtomLeft.x, pixel_ButtomLeft.y));
  vec3 ray_ButtomRight = frustrumRay(vec2(pixel_TopRight.x, pixel_ButtomLeft.y));

  float tile_nearZ = -zNear * pow(zFar / zNear, float(sliceZ) / float(gridDimZ));
  float tile_farZ = -zNear * pow(zFar / zNear, float(sliceZ + 1.0) / float(gridDimZ));

    //FACE FAR IN VIEW SPACE
  vec3 Far_TL_AABB = ray_TopLeft * (tile_farZ / ray_TopLeft.z);
  vec3 Far_TR_AABB = ray_TopRight * (tile_farZ / ray_TopRight.z);
  vec3 Far_BL_AABB = ray_ButtomLeft * (tile_farZ / ray_ButtomLeft.z);
  vec3 Far_BR_AABB = ray_ButtomRight * (tile_farZ / ray_ButtomRight.z);

    //FACE NEAR IN VIEW SPACE
  vec3 Near_TL_AABB = ray_TopLeft * (tile_nearZ / ray_TopLeft.z);
  vec3 Near_TR_AABB = ray_TopRight * (tile_nearZ / ray_TopRight.z);
  vec3 Near_BL_AABB = ray_ButtomLeft * (tile_nearZ / ray_ButtomLeft.z);
  vec3 Near_BR_AABB = ray_ButtomRight * (tile_nearZ / ray_ButtomRight.z);

  vec3 minPos_AABB =
  min(Far_TL_AABB, min(Far_TR_AABB, min(Far_BL_AABB, min(Far_BR_AABB,
  min(Near_TL_AABB, min(Near_TR_AABB, min(Near_BL_AABB, Near_BR_AABB)))))));

  vec3 maxPos_AABB =
  max(Far_TL_AABB, max(Far_TR_AABB, max(Far_BL_AABB, max(Far_BR_AABB,
  max(Near_TL_AABB, max(Near_TR_AABB, max(Near_BL_AABB, Near_BR_AABB)))))));

      clusters[clusterIndex].minPoint = vec4(minPos_AABB, 1.0);
      clusters[clusterIndex].maxPoint = vec4(maxPos_AABB, 1.0);
}