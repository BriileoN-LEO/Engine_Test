#version 460 core
//#define tileSize 16.0

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

uniform vec2 screenSize_D;
uniform mat4 inverseProj_D;
uniform float zNear; //NEW
uniform float zFar;   //NEW
uniform uint gridDimX;   //NEW
uniform uint gridDimY;   //NEW
uniform uint gridDimZ;   //NEW


