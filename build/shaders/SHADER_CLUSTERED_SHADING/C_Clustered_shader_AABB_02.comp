struct cluster_D
{
 vec4 minPoint;
 vec4 maxPoint;
};

layout (std430, binding = 4) buffer clustersBuffer
{
 cluster_D clusters[];
};


vec3 frustrumRay(vec2 screenPixel_coord)
{
    vec2 NDC_xy = ((screenPixel_coord / screenSize_D) * 2.0) - 1.0;

    vec4 clipSpace = vec4(NDC_xy, -1.0, 1.0);

    vec4 viewSpace = inverseProj_D * clipSpace;

    return viewSpace.xyz / viewSpace.w;
}
